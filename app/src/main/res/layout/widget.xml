<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">
        <TextView
            android:id="@+id/wBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#F4F2EE"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wBigL"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingBottom="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="ккал залишилось"
            android:textColor="#8E8C88"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Форма"
            android:textColor="#FF7D5C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/wK" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="1" android:text="Ккал 0 / 0" android:textColor="#F4F2EE" android:textSize="12sp" />
    <ProgressBar android:id="@+id/wKb" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_k" />

    <TextView android:id="@+id/wP" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="1" android:text="Білки 0 / 0 г" android:textColor="#F4F2EE" android:textSize="12sp" />
    <ProgressBar android:id="@+id/wPb" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_p" />

    <TextView android:id="@+id/wW" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="1" android:text="Вода 0 / 0 л" android:textColor="#F4F2EE" android:textSize="12sp" />
    <ProgressBar android:id="@+id/wWb" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_w" />
</LinearLayout>
